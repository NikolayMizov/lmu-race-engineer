<Application x:Class="LmuRaceEngineerCS.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- "Apex HUD" design system: carbon/neon palette, fonts, card styles -->
            <ResourceDictionary Source="Themes/ApexTheme.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <!-- ── Colors (re-pointed to the Apex HUD palette) ──────────────────────
             These legacy keys are kept so existing pages restyle automatically;
             the design's own keys (BgApp, Text2-5, Border1-3, Card…) come from
             the merged ApexTheme.xaml. Direct definitions here win over the merge. -->
        <SolidColorBrush x:Key="BgBrush"      Color="#FF0A0B0E"/>
        <SolidColorBrush x:Key="PanelBrush"   Color="#FF0D0F13"/>
        <SolidColorBrush x:Key="CardBrush"    Color="#FF13161C"/>
        <SolidColorBrush x:Key="Card2Brush"   Color="#FF181B21"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#FF262B34"/>
        <SolidColorBrush x:Key="Border2Brush" Color="#FF1C1F25"/>
        <SolidColorBrush x:Key="FgBrush"      Color="#FFF4F5F7"/>
        <SolidColorBrush x:Key="DimBrush"     Color="#FF9AA2AD"/>
        <SolidColorBrush x:Key="Dim2Brush"    Color="#FFCBD2DB"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#FF3DA5FF"/>
        <SolidColorBrush x:Key="GreenBrush"   Color="#FF33C25A"/>
        <SolidColorBrush x:Key="YellowBrush"  Color="#FFFFC24B"/>
        <SolidColorBrush x:Key="RedBrush"     Color="#FFE10600"/>
        <SolidColorBrush x:Key="PurpleBrush"  Color="#FF9B72E8"/>
        <SolidColorBrush x:Key="BlueBrush"    Color="#FF3DA5FF"/>
        <SolidColorBrush x:Key="NavBgBrush"   Color="#FF0C0D11"/>
        <SolidColorBrush x:Key="NavActiveBrush" Color="#FFE10600"/>
        <SolidColorBrush x:Key="PushBrush"    Color="#FFFF3333"/>
        <SolidColorBrush x:Key="SaveBrush"    Color="#FF33C25A"/>

        <!-- ── Shared styles ────────────────────────────────────────────────── -->
        <Style x:Key="LabelXs" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource DimBrush}"/>
        </Style>

        <Style x:Key="NumSm" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        </Style>

        <Style x:Key="NumMd" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        </Style>

        <Style x:Key="NumLg" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="38"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        </Style>

        <Style x:Key="NumXl" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="52"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
        </Style>

        <!-- Primary card -->
        <Style x:Key="PrimaryCard" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="16,12,16,12"/>
        </Style>

        <!-- Secondary card -->
        <Style x:Key="SecondaryCard" TargetType="Border">
            <Setter Property="Background"       Value="{StaticResource Card2Brush}"/>
            <Setter Property="BorderBrush"      Value="{StaticResource Border2Brush}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="12,8,12,8"/>
        </Style>

        <!-- ComboBox dark theme -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{StaticResource Card2Brush}"/>
            <Setter Property="Foreground"      Value="{StaticResource FgBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,3"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll"              Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>
                            <!-- Selection box + border -->
                            <Border Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            <!-- Dropdown arrow -->
                            <Path Grid.Column="1"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="{StaticResource DimBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>
                            <!-- Invisible toggle button covering whole control -->
                            <ToggleButton Grid.ColumnSpan="2"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False" ClickMode="Press"/>
                            <!-- Dropdown popup -->
                            <Popup x:Name="PART_Popup"
                                   Grid.ColumnSpan="2"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border Background="{StaticResource Card2Brush}"
                                        BorderBrush="{StaticResource BorderBrush2}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource Card2Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
            <Setter Property="Padding"    Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BorderBrush2}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav button -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource Dim2Brush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"     Value="12,12"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1a1a1a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

      </ResourceDictionary>
    </Application.Resources>
</Application>
