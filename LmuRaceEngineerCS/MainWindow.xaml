<Window x:Class="LmuRaceEngineerCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LmuRaceEngineerCS.Views"
        Title="Race Engineer" Height="900" Width="1440"
        MinHeight="780" MinWidth="1200"
        WindowState="Maximized"
        Background="{StaticResource BgBrush}"
        WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarCol" Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ─────────────────────────────────────────────────────── -->
        <Border x:Name="Sidebar" Grid.Column="0" Background="{StaticResource NavBgBrush}">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,12,10">
                    <TextBlock Text="RACE" Foreground="{StaticResource RedBrush}"
                               Effect="{StaticResource RedGlow}"
                               FontFamily="Arial Black, Arial" FontStyle="Italic" FontWeight="Black"
                               FontSize="26" LineHeight="25" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock Text="ENGINEER" Foreground="{StaticResource RedBrush}"
                               Effect="{StaticResource RedGlow}"
                               FontFamily="Arial Black, Arial" FontStyle="Italic" FontWeight="Black"
                               FontSize="26" LineHeight="25" LineStackingStrategy="BlockLineHeight"/>
                </StackPanel>
                <Rectangle DockPanel.Dock="Top" Height="1" Fill="{StaticResource BorderBrush2}" Margin="8,4,8,8"/>

                <!-- Nav buttons -->
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="BtnTelemetry"  Style="{StaticResource NavBtn}"
                            Content="○   Telemetry"  Click="NavClick" Tag="telemetry"/>
                    <Button x:Name="BtnEngineer"   Style="{StaticResource NavBtn}"
                            Content="⌬   Engineer"   Click="NavClick" Tag="engineer"/>
                    <Button x:Name="BtnProfiles"   Style="{StaticResource NavBtn}"
                            Content="◐   Profiles"   Click="NavClick" Tag="profiles"/>
                    <Button x:Name="BtnMonitoring" Style="{StaticResource NavBtn}"
                            Content="◉   Monitoring" Click="NavClick" Tag="monitoring"/>
                    <Button x:Name="BtnLaps"       Style="{StaticResource NavBtn}"
                            Content="◷   Lap Times"  Click="NavClick" Tag="laps"/>
                    <Button x:Name="BtnVoice"      Style="{StaticResource NavBtn}"
                            Content="◎   Voice Log"  Click="NavClick" Tag="voice"/>
                    <Button x:Name="BtnSettings"   Style="{StaticResource NavBtn}"
                            Content="⚙   Settings"   Click="NavClick" Tag="settings"/>
                </StackPanel>

                <!-- Version at bottom -->
                <TextBlock DockPanel.Dock="Bottom" Text="v2.0 CS"
                           Foreground="{StaticResource DimBrush}"
                           FontFamily="Segoe UI" FontSize="12"
                           Margin="12,0,12,12" VerticalAlignment="Bottom"/>
            </DockPanel>
        </Border>

        <!-- ── Right area ──────────────────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="{StaticResource PanelBrush}">
                <Border.BorderBrush><SolidColorBrush Color="#242424"/></Border.BorderBrush>
                <Border.BorderThickness>0,0,0,1</Border.BorderThickness>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hamburger toggle -->
                    <Button x:Name="BtnToggleSidebar" Grid.Column="0"
                            Content="☰" Click="ToggleSidebar_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource Dim2Brush}"
                            FontSize="20" Width="48" Cursor="Hand"
                            VerticalAlignment="Stretch" ToolTip="Toggle menu"/>

                    <TextBlock x:Name="TbHeader" Grid.Column="1" Text="Waiting for game…"
                               Foreground="{StaticResource Dim2Brush}"
                               FontFamily="Segoe UI" FontSize="14"
                               Margin="8,0,16,0"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,16,0">
                        <ToggleButton x:Name="BtnEditLayout" Content="✥ Edit Layout"
                                      Click="EditLayout_Click"
                                      Background="Transparent" BorderThickness="1"
                                      BorderBrush="{StaticResource BorderBrush2}"
                                      Foreground="{StaticResource Dim2Brush}"
                                      FontFamily="Segoe UI" FontSize="12" Padding="8,3"
                                      Margin="0,0,16,0" Cursor="Hand"
                                      ToolTip="Resize mode: drag the corner grip on any data box to resize it (sizes are saved)."/>
                        <Ellipse x:Name="ConnDot" Width="10" Height="10"
                                 Fill="{StaticResource DimBrush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TbConn" Text="Disconnected"
                                   Foreground="{StaticResource DimBrush}"
                                   FontFamily="Segoe UI" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page host: single-cell Grid guarantees children stretch to fill available space -->
            <Grid x:Name="PageFrame" Grid.Row="1"
                  Background="{StaticResource BgBrush}"
                  ClipToBounds="True"/>
        </Grid>
    </Grid>
</Window>
