<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!--  RACE ENGINEER  ·  Direction B "Apex HUD" theme              -->
    <!--  Carbon / neon motorsport palette. Blue accent #3da5ff.      -->
    <!-- ============================================================ -->

    <!-- ===== Fonts =====
         Drop the .ttf files into a project folder named "Fonts" with
         Build Action = Resource (see README). The names after '#' must
         match the font's internal family name exactly. Fallbacks kick in
         if the files are missing. -->
    <FontFamily x:Key="FontSaira">pack://application:,,,/Fonts/#Saira Condensed, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">pack://application:,,,/Fonts/#JetBrains Mono, Consolas</FontFamily>

    <!-- ===== Core colors ===== -->
    <Color x:Key="C_BgApp">#FF0A0B0E</Color>
    <Color x:Key="C_Accent">#FF3DA5FF</Color>
    <Color x:Key="C_Red">#FFE10600</Color>
    <Color x:Key="C_Green">#FF33C25A</Color>
    <Color x:Key="C_Amber">#FFFFC24B</Color>

    <!-- ===== Brushes : surfaces ===== -->
    <SolidColorBrush x:Key="BgApp"        Color="#FF0A0B0E"/>
    <SolidColorBrush x:Key="BgSidebar"    Color="#FF0C0D11"/>
    <SolidColorBrush x:Key="BgBar"        Color="#FF0D0F13"/>
    <SolidColorBrush x:Key="BgPanel"      Color="#FF101216"/>
    <SolidColorBrush x:Key="BgInset"      Color="#FF07080B"/>
    <SolidColorBrush x:Key="BgTableHead"  Color="#FF0E1014"/>

    <!-- ===== Brushes : borders ===== -->
    <SolidColorBrush x:Key="Border1" Color="#FF1C1F25"/>
    <SolidColorBrush x:Key="Border2" Color="#FF262B34"/>
    <SolidColorBrush x:Key="Border3" Color="#FF23262D"/>

    <!-- ===== Brushes : text ===== -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF4F5F7"/>
    <SolidColorBrush x:Key="Text2"       Color="#FFCBD2DB"/>
    <SolidColorBrush x:Key="Text3"       Color="#FF9AA2AD"/>
    <SolidColorBrush x:Key="Text4"       Color="#FF8A93A0"/>
    <SolidColorBrush x:Key="Text5"       Color="#FF7B8390"/>
    <SolidColorBrush x:Key="TextMuted"   Color="#FF6B7280"/>
    <SolidColorBrush x:Key="TextDim"     Color="#FF5D646E"/>
    <SolidColorBrush x:Key="TextFaint"   Color="#FF4A5059"/>

    <!-- ===== Brushes : signal ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3DA5FF"/>
    <SolidColorBrush x:Key="RedBrush"    Color="#FFE10600"/>
    <SolidColorBrush x:Key="GreenBrush"  Color="#FF33C25A"/>
    <SolidColorBrush x:Key="AmberBrush"  Color="#FFFFC24B"/>

    <!-- ===== Card gradient (top #15181E -> bottom #101216) ===== -->
    <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF15181E" Offset="0"/>
        <GradientStop Color="#FF101216" Offset="1"/>
    </LinearGradientBrush>

    <!-- Red-wash strategy gradient (left -> right) -->
    <LinearGradientBrush x:Key="RedWash" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#29E10600" Offset="0"/>
        <GradientStop Color="#FF15181E" Offset="0.55"/>
    </LinearGradientBrush>

    <!-- Blue-wash banner gradient -->
    <LinearGradientBrush x:Key="BlueWash" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#293DA5FF" Offset="0"/>
        <GradientStop Color="#FF15181E" Offset="0.6"/>
    </LinearGradientBrush>

    <!-- ===== Glows ===== -->
    <DropShadowEffect x:Key="RedGlow"    Color="#FFE10600" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
    <DropShadowEffect x:Key="AccentGlow" Color="#FF3DA5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.5"/>

    <!-- ============================================================ -->
    <!--  Reusable element styles                                     -->
    <!-- ============================================================ -->

    <!-- Card: gradient surface, thin border, rounded -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardGradient}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Flat panel (no gradient) -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgPanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border2}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <!-- Inset well -->
    <Style x:Key="Inset" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgInset}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <!-- Left accent bar (place as first child of a Grid inside a Card) -->
    <Style x:Key="AccentBar" TargetType="Border">
        <Setter Property="Width" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="CornerRadius" Value="6,0,0,6"/>
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    </Style>

    <!-- ============================================================ -->
    <!--  Text styles                                                 -->
    <!-- ============================================================ -->

    <!-- Section title: italic, spaced, muted -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSaira}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource Text4}"/>
    </Style>

    <!-- Caption: tiny muted label -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSaira}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    </Style>

    <!-- Field label -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSaira}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Text3}"/>
    </Style>

    <!-- Big mono number -->
    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <!-- Mono value -->
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <!-- Page heading -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSaira}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    </Style>

    <!-- Default TextBlock = Saira, light -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontSaira}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- ============================================================ -->
    <!--  Minimal flat scrollbar                                      -->
    <!-- ============================================================ -->
    <Style x:Key="FlatScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource Border2}" CornerRadius="5"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="{StaticResource BgApp}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{StaticResource BgApp}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource FlatScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!--  Nav item (ListBoxItem) style                                -->
    <!-- ============================================================ -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text4}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                        <ContentPresenter Margin="19,13,22,13"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RedBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="White"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
