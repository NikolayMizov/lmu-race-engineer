<UserControl x:Class="LmuRaceEngineerCS.Views.DriverProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LmuRaceEngineerCS.Views"
             Background="{StaticResource BgApp}">

    <UserControl.Resources>
        <local:FractionToStarConverter x:Key="StarConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Clickable profile row (toggles its tips) -->
        <Style x:Key="ProfileRowToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#10FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22">

            <!-- ── Title row ─────────────────────────────────────────────────── -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Driver Profiles" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Learned driving style per track — click a row for tips"
                               Foreground="{StaticResource Text5}" FontSize="15"
                               VerticalAlignment="Bottom" Margin="14,0,0,5"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Refresh_Click" Cursor="Hand" BorderThickness="0" Padding="0"
                        Background="Transparent">
                    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border2}"
                            BorderThickness="1" CornerRadius="4" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⟳" Foreground="{StaticResource Text3}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" Foreground="{StaticResource Text3}" FontSize="14" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>

            <!-- ── Stats strip ──────────────────────────────────────────────── -->
            <Border Margin="0,12,0,0" Style="{StaticResource Card}" Background="{StaticResource BlueWash}">
                <Grid>
                    <Border Style="{StaticResource AccentBar}" Effect="{StaticResource AccentGlow}"/>
                    <StackPanel Orientation="Horizontal" Margin="20,16">
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="TRACKS PROFILED" Style="{StaticResource Caption}" FontSize="11"/>
                            <TextBlock x:Name="TbTrackCount" Text="0" Style="{StaticResource BigNumber}"
                                       FontSize="30" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,30,0">
                            <TextBlock Text="TOTAL STINTS" Style="{StaticResource Caption}" FontSize="11"/>
                            <TextBlock x:Name="TbStintCount" Text="0" Style="{StaticResource BigNumber}"
                                       FontSize="30" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <Border BorderBrush="{StaticResource Border3}" BorderThickness="1,0,0,0" Padding="30,0,0,0">
                            <StackPanel MaxWidth="700">
                                <TextBlock Text="HOW THE SPLIT WORKS" Style="{StaticResource Caption}" FontSize="11"/>
                                <TextBlock Foreground="{StaticResource Text3}" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Confidence = min(1, stints ÷ 5). The engine blends your learned onset by that weight and the generic 0.60 model by the rest."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Table ────────────────────────────────────────────────────── -->
            <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <!-- header -->
                    <Border Background="{StaticResource BgTableHead}" CornerRadius="6,6,0,0">
                        <Grid Margin="20,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="0.6*"/><ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="0.6*"/><ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="0.9*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TRACK" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="1" Text="DRIVING STYLE" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="2" Text="STINTS" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="AVG ONSET" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="DRIFT" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="5" Text="CONF (YOU·ENG)" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="6" Text="UPDATED" Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- rows -->
                    <ItemsControl x:Name="ProfileTable">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border1}" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <ToggleButton Style="{StaticResource ProfileRowToggle}"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                            <Grid Margin="20,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.6*"/><ColumnDefinition Width="1.4*"/>
                                                    <ColumnDefinition Width="0.6*"/><ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="0.6*"/><ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Track}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="9" Height="9" Fill="{Binding StyleBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Style}" FontSize="15" Foreground="{Binding StyleBrush}" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Stints}" Style="{StaticResource Mono}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding OnsetLabel}" Style="{StaticResource Mono}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding CliffLabel}" Style="{StaticResource Mono}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding ConfidenceLabel}" Style="{StaticResource Mono}" FontSize="15" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="{Binding Updated}" Style="{StaticResource Mono}" FontSize="15" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ToggleButton>

                                        <!-- Expansion: confidence bar + tips -->
                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                                Background="{StaticResource BgInset}" Padding="20,14,20,16"
                                                BorderBrush="{StaticResource Border1}" BorderThickness="0,1,0,0">
                                            <StackPanel>
                                                <TextBlock Text="CONFIDENCE SPLIT" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                                                <Grid Height="16" Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding DriverConfFraction, Converter={StaticResource StarConv}}"/>
                                                        <ColumnDefinition Width="{Binding EngineConfFraction, Converter={StaticResource StarConv}}"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="{StaticResource AccentBrush}" CornerRadius="2,0,0,2"/>
                                                    <Border Grid.Column="1" Background="{StaticResource Border2}" CornerRadius="0,2,2,0"/>
                                                </Grid>
                                                <TextBlock Text="{Binding ConfidenceDetail}" Foreground="{StaticResource Text4}"
                                                           FontSize="13" Margin="0,0,0,12"/>

                                                <TextBlock Text="DRIVING &amp; STRATEGY TIPS" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                                <ItemsControl ItemsSource="{Binding Tips}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource Panel}" Margin="0,0,0,6" Padding="12,9">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Icon}" Foreground="{Binding IconBrush}"
                                                                               FontSize="15" Margin="0,0,11,0" VerticalAlignment="Top"/>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Title}" Foreground="{Binding IconBrush}"
                                                                                   FontSize="14" FontWeight="Bold" Margin="0,0,0,2"/>
                                                                        <TextBlock Text="{Binding Body}" Foreground="{StaticResource Text2}"
                                                                                   FontSize="14" TextWrapping="Wrap" MaxWidth="860" HorizontalAlignment="Left"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <TextBlock x:Name="TbEmpty"
                               Text="No driver profiles learned yet. Finish a race or practice session and they'll appear here."
                               Foreground="{StaticResource TextMuted}" FontSize="14" TextAlignment="Center"
                               Margin="20,26" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
