<UserControl x:Class="LmuRaceEngineerCS.Views.EngineerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:LmuRaceEngineerCS.Controls"
             Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: Header -->
            <RowDefinition Height="Auto"/>   <!-- 1: Driver handover strip -->
            <RowDefinition Height="*"/>      <!-- 2: Hosted Strategy panel -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,16,16,8">
            <TextBlock Text="Engineer" Foreground="{StaticResource FgBrush}"
                       FontFamily="Segoe UI" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="  Strategy command for driver &amp; engineer — with driver-swap handover"
                       Foreground="{StaticResource DimBrush}" FontFamily="Segoe UI" FontSize="10"
                       VerticalAlignment="Bottom" Margin="0,0,0,3"/>
        </StackPanel>

        <!-- ── Driver handover strip ──────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" Margin="16,0,16,8">
            <DockPanel Margin="14,10,14,12">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,7">
                    <TextBlock Text="DRIVER HANDOVER"
                               Foreground="{StaticResource DimBrush}"
                               FontFamily="Segoe UI" FontSize="9" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnPopOut" Content="⤢" Click="PopOut_Click"
                            HorizontalAlignment="Right" Padding="8,2"
                            Background="Transparent" Foreground="{StaticResource Dim2Brush}"
                            BorderThickness="0" FontFamily="Segoe UI" FontSize="12" Cursor="Hand"
                            ToolTip="Pop out to a separate window"/>
                </Grid>
                <ctl:ResizableDataBox WidgetId="eng-handover">
                    <ContentControl x:Name="HandoverHost"/>
                </ctl:ResizableDataBox>
            </DockPanel>
        </Border>

        <!-- ── Hosted Strategy panel (reused verbatim) ────────────────────────── -->
        <ContentControl x:Name="StrategyHost" Grid.Row="2"/>
    </Grid>
</UserControl>
