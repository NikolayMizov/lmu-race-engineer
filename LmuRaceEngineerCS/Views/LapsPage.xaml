<UserControl x:Class="LmuRaceEngineerCS.Views.LapsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
             xmlns:oxys="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf.Shared"
             Background="{StaticResource BgApp}">

    <UserControl.Resources>
        <!-- DataGrid column-header look (carbon table head) -->
        <Style x:Key="LapHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BgTableHead}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border1}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>                <!-- 0: Header -->
            <RowDefinition Height="Auto"/>                <!-- 1: Controls -->
            <RowDefinition Height="240" MinHeight="120"/> <!-- 2: Chart -->
            <RowDefinition Height="6"/>                   <!-- 3: Splitter -->
            <RowDefinition Height="*"/>                   <!-- 4: Lap table -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Lap Log" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Lap-by-lap — time, tire health &amp; usage, mode"
                           Foreground="{StaticResource Text5}" FontSize="15"
                           VerticalAlignment="Bottom" Margin="14,0,0,5"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="ExportCsv_Click"
                    Cursor="Hand" BorderThickness="0" Padding="0" Background="Transparent">
                <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="16,8">
                    <TextBlock Text="↧ Export CSV" Foreground="#FF04121F" FontSize="14" FontWeight="SemiBold"/>
                </Border>
            </Button>
        </Grid>

        <!-- ── Controls ───────────────────────────────────────────────────────── -->
        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="14,10">
                <TextBlock Text="SESSION" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="FilterCombo" Width="90" FontFamily="{StaticResource FontMono}" FontSize="11"
                          SelectedIndex="0" Margin="0,0,8,0">
                    <ComboBoxItem Content="All"/>
                    <ComboBoxItem Content="Race"/>
                    <ComboBoxItem Content="Practice"/>
                    <ComboBoxItem Content="Quali"/>
                </ComboBox>
                <ComboBox x:Name="SessionCombo" Width="360" FontFamily="{StaticResource FontMono}" FontSize="11"
                          SelectionChanged="SessionCombo_Changed"/>
                <Button Content="⟳" Click="Refresh_Click" Padding="9,4" Margin="6,0,0,0"
                        Background="{StaticResource BgPanel}" Foreground="{StaticResource Text3}"
                        BorderThickness="0" FontFamily="Segoe UI" Cursor="Hand" ToolTip="Reload session list"/>

                <Rectangle Width="1" Fill="{StaticResource Border2}" Margin="14,2,12,2"/>

                <TextBlock Text="TIRE HEALTH" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="HealthBasisCombo" Width="130" FontFamily="{StaticResource FontMono}" FontSize="11"
                          SelectedIndex="0" SelectionChanged="HealthBasis_Changed"
                          ToolTip="How the 'health at start' figure is summarised across the 4 tires">
                    <ComboBoxItem Content="Average of 4"/>
                    <ComboBoxItem Content="Lowest corner"/>
                </ComboBox>

                <Rectangle Width="1" Fill="{StaticResource Border2}" Margin="14,2,12,2"/>
                <Button Content="🗑  Clear All" Click="ClearAll_Click" Padding="9,4"
                        Background="{StaticResource BgPanel}" Foreground="{StaticResource RedBrush}"
                        BorderThickness="0" FontFamily="Segoe UI" FontSize="12" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- ── Lap-time chart (Y = lap time, hover for detail) ────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="LAP TIME PROGRESSION — HOVER A LAP FOR DETAIL" Style="{StaticResource SectionTitle}"
                               VerticalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="● Normal" Foreground="#FFC7C7C7" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,0,10,0"/>
                        <TextBlock Text="● Push"   Foreground="{StaticResource RedBrush}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,0,10,0"/>
                        <TextBlock Text="● Save"   Foreground="{StaticResource GreenBrush}" FontFamily="{StaticResource FontMono}" FontSize="11" Margin="0,0,10,0"/>
                        <TextBlock Text="● Best"   Foreground="{StaticResource PurpleBrush}" FontFamily="{StaticResource FontMono}" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <oxy:PlotView x:Name="LapChart" Grid.Row="1" Background="Transparent">
                    <!-- Dark, high-contrast hover tooltip (default is a bright box) -->
                    <oxy:PlotView.DefaultTrackerTemplate>
                        <ControlTemplate>
                            <oxys:TrackerControl Position="{Binding Position}"
                                                 LineExtents="{Binding PlotModel.PlotArea}"
                                                 Background="#F21A1A1A"
                                                 BorderBrush="#3A3A3A"
                                                 LineStroke="#553A3A3A">
                                <oxys:TrackerControl.Content>
                                    <TextBlock Text="{Binding}" Margin="8,5"
                                               Foreground="#F4F5F7"
                                               FontFamily="Consolas" FontSize="12"/>
                                </oxys:TrackerControl.Content>
                            </oxys:TrackerControl>
                        </ControlTemplate>
                    </oxy:PlotView.DefaultTrackerTemplate>
                </oxy:PlotView>
                <TextBlock x:Name="ChartEmpty" Grid.Row="1" Text="Load a session to see lap times"
                           Foreground="{StaticResource TextMuted}" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>
            </Grid>
        </Border>

        <!-- ── Splitter ────────────────────────────────────────────────────────── -->
        <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch"
                      Background="{StaticResource Border2}"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>

        <!-- ── Lap table ───────────────────────────────────────────────────────── -->
        <Border Grid.Row="4" Style="{StaticResource Card}">
            <DataGrid x:Name="LapTable"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" Foreground="{StaticResource TextPrimary}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource Border1}"
                      RowBackground="Transparent" AlternatingRowBackground="#11FFFFFF"
                      ColumnHeaderHeight="30" RowHeight="26"
                      FontFamily="{StaticResource FontMono}" FontSize="12"
                      BorderThickness="0"
                      ColumnHeaderStyle="{StaticResource LapHeader}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#"              Binding="{Binding Seq}"        Width="40"/>
                    <DataGridTextColumn Header="GAME LAP"       Binding="{Binding Lap}"        Width="70"/>
                    <DataGridTextColumn Header=""               Binding="{Binding Flag}"       Width="46"/>
                    <DataGridTextColumn Header="MODE"           Binding="{Binding Mode}"       Width="70"/>
                    <DataGridTextColumn Header="LAP TIME"       Binding="{Binding Time}"       Width="110"/>
                    <DataGridTextColumn Header="S1"             Binding="{Binding S1}"         Width="90"/>
                    <DataGridTextColumn Header="S2"             Binding="{Binding S2}"         Width="90"/>
                    <DataGridTextColumn Header="S3"             Binding="{Binding S3}"         Width="90"/>
                    <DataGridTextColumn Header="USED % (AVG 4)" Binding="{Binding Used}"       Width="110"/>
                    <DataGridTextColumn Header="HEALTH @ START" Binding="{Binding HealthText}" Width="120"/>
                    <DataGridTextColumn Header="ENERGY @ START" Binding="{Binding Energy}"     Width="120"/>
                    <DataGridTextColumn Header="NRG USED %"     Binding="{Binding NrgUsed}"    Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
