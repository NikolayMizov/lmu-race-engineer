<UserControl x:Class="LmuRaceEngineerCS.Views.MonitoringPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:LmuRaceEngineerCS.Controls"
             Background="{StaticResource BgApp}">

    <UserControl.Resources>
        <Style x:Key="RowKey" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="RowVal" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="TyreLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22">

            <TextBlock Text="Race Monitor" Style="{StaticResource PageTitle}"/>

            <!-- ── Session + Pit window ─────────────────────────────────────── -->
            <UniformGrid Rows="1" Columns="2" Margin="0,12,0,0">
                <ctl:ResizableDataBox WidgetId="mon-session" Margin="0,0,14,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="18,16">
                        <TextBlock Text="SESSION" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Track" Style="{StaticResource RowKey}"/>
                            <TextBlock x:Name="MonTrack" Text="—" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="Session Type" Style="{StaticResource RowKey}"/>
                            <TextBlock x:Name="MonSession" Text="—" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="Time Remaining" Style="{StaticResource RowKey}"/>
                            <TextBlock x:Name="MonTimeRem" Text="—" Style="{StaticResource RowVal}" Foreground="{StaticResource RedBrush}"/>
                        </Grid>
                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="Est. Total Laps" Style="{StaticResource RowKey}"/>
                            <TextBlock x:Name="MonTotalLaps" Text="—" Style="{StaticResource RowVal}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                </ctl:ResizableDataBox>
                <ctl:ResizableDataBox WidgetId="mon-pitwindow">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Border Style="{StaticResource AccentBar}"/>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="PIT WINDOW" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="Time to Pit" Style="{StaticResource RowKey}"/>
                                <TextBlock x:Name="MonTimeToPit" Text="—" Style="{StaticResource RowVal}" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <TextBlock Text="Recommended" Style="{StaticResource RowKey}"/>
                                <TextBlock x:Name="MonPitRec" Text="—" Style="{StaticResource RowVal}"/>
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <TextBlock Text="Earliest" Style="{StaticResource RowKey}"/>
                                <TextBlock x:Name="MonPitEarly" Text="—" Style="{StaticResource RowVal}"/>
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <TextBlock Text="Latest" Style="{StaticResource RowKey}"/>
                                <TextBlock x:Name="MonPitLatest" Text="—" Style="{StaticResource RowVal}"/>
                            </Grid>
                            <Grid Margin="0,9,0,0">
                                <TextBlock Text="Limiter" Style="{StaticResource RowKey}"/>
                                <TextBlock x:Name="MonPitLimiter" Text="—" FontWeight="Bold" Foreground="{StaticResource AmberBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                </ctl:ResizableDataBox>
            </UniformGrid>

            <!-- ── Position + gaps ──────────────────────────────────────────── -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <ctl:ResizableDataBox WidgetId="mon-position" Grid.Column="0" Margin="0,0,14,0">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Border Style="{StaticResource AccentBar}" Background="{StaticResource RedBrush}"/>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="POSITION" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="MonPos" Text="P—" Style="{StaticResource BigNumber}" FontSize="72" Foreground="{StaticResource RedBrush}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="MonPosOf" Text="—" Foreground="{StaticResource Text3}" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </Border>
                </ctl:ResizableDataBox>
                <ctl:ResizableDataBox WidgetId="mon-gapfwd" Grid.Column="1" Margin="0,0,14,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="18,16" VerticalAlignment="Center">
                        <TextBlock Text="GAP AHEAD" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="MonGapFwd" Text="—" Style="{StaticResource BigNumber}" FontSize="40" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="MonGainFwd" Text="" Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Text4}"/>
                    </StackPanel>
                </Border>
                </ctl:ResizableDataBox>
                <ctl:ResizableDataBox WidgetId="mon-gapbhd" Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="18,16" VerticalAlignment="Center">
                        <TextBlock Text="GAP BEHIND" Style="{StaticResource SectionTitle}"/>
                        <TextBlock x:Name="MonGapBhd" Text="—" Style="{StaticResource BigNumber}" FontSize="40" Foreground="{StaticResource RedBrush}"/>
                        <TextBlock x:Name="MonGainBhd" Text="" Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Text4}"/>
                    </StackPanel>
                </Border>
                </ctl:ResizableDataBox>
            </Grid>

            <!-- ── Tire health + Energy ─────────────────────────────────────── -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <ctl:ResizableDataBox WidgetId="mon-tire" Grid.Column="0" Margin="0,0,14,0">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Border Style="{StaticResource AccentBar}" Background="{StaticResource GreenBrush}"/>
                        <StackPanel Margin="18,16">
                            <Grid>
                                <TextBlock Text="TIRE HEALTH" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="MonTireStatus" Text="—" FontSize="13" HorizontalAlignment="Right" Foreground="{StaticResource GreenBrush}"/>
                            </Grid>
                            <UniformGrid Rows="1" Columns="4" Margin="0,14,0,0">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="FL" Style="{StaticResource TyreLabel}"/>
                                    <TextBlock x:Name="MonTempFL" Text="—" Style="{StaticResource Mono}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <ProgressBar x:Name="MonBarFL" Maximum="100" Height="7" Margin="0,6,0,0" Background="{StaticResource BgInset}" BorderThickness="0"/>
                                    <TextBlock x:Name="MonTireFL" Text="—" Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Text3}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="FR" Style="{StaticResource TyreLabel}"/>
                                    <TextBlock x:Name="MonTempFR" Text="—" Style="{StaticResource Mono}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <ProgressBar x:Name="MonBarFR" Maximum="100" Height="7" Margin="0,6,0,0" Background="{StaticResource BgInset}" BorderThickness="0"/>
                                    <TextBlock x:Name="MonTireFR" Text="—" Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Text3}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="RL" Style="{StaticResource TyreLabel}"/>
                                    <TextBlock x:Name="MonTempRL" Text="—" Style="{StaticResource Mono}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <ProgressBar x:Name="MonBarRL" Maximum="100" Height="7" Margin="0,6,0,0" Background="{StaticResource BgInset}" BorderThickness="0"/>
                                    <TextBlock x:Name="MonTireRL" Text="—" Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Text3}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="RR" Style="{StaticResource TyreLabel}"/>
                                    <TextBlock x:Name="MonTempRR" Text="—" Style="{StaticResource Mono}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    <ProgressBar x:Name="MonBarRR" Maximum="100" Height="7" Margin="0,6,0,0" Background="{StaticResource BgInset}" BorderThickness="0"/>
                                    <TextBlock x:Name="MonTireRR" Text="—" Style="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Text3}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="Stint lap" Style="{StaticResource RowKey}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="MonStintLap" Text="—" Style="{StaticResource Mono}" FontWeight="Bold"/>
                                    <TextBlock x:Name="MonPredStint" Text="" Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Text4}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                </ctl:ResizableDataBox>
                <ctl:ResizableDataBox WidgetId="mon-energy" Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Border Style="{StaticResource AccentBar}"/>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="ENERGY / FUEL" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="Virtual energy" Style="{StaticResource RowKey}"/>
                                <TextBlock x:Name="MonVe" Text="—" Style="{StaticResource RowVal}" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Laps on fuel" Style="{StaticResource RowKey}"/>
                                <TextBlock x:Name="MonLapsVe" Text="—" Style="{StaticResource RowVal}"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Per lap (avg)" Style="{StaticResource RowKey}"/>
                                <TextBlock x:Name="MonPerLap" Text="—" Style="{StaticResource RowVal}"/>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Extra stops" Style="{StaticResource RowKey}"/>
                                <TextBlock x:Name="MonExtraStops" Text="0" Style="{StaticResource RowVal}"/>
                            </Grid>
                            <Border BorderBrush="{StaticResource Border3}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                                <TextBlock x:Name="MonFuelStatus" Text="—" FontSize="14" Foreground="{StaticResource GreenBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                </ctl:ResizableDataBox>
            </Grid>

            <!-- ── Lap times + Strategy ─────────────────────────────────────── -->
            <Grid Margin="0,12,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <ctl:ResizableDataBox WidgetId="mon-laptimes" Grid.Column="0" Margin="0,0,14,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="18,16">
                        <TextBlock Text="LAP TIMES" Style="{StaticResource SectionTitle}"/>
                        <UniformGrid Rows="2" Columns="2" Margin="0,12,0,0">
                            <Grid Margin="0,0,30,9">
                                <TextBlock Text="Last Lap" Style="{StaticResource RowKey}"/>
                                <TextBlock x:Name="MonLastLap" Text="—" Style="{StaticResource RowVal}"/>
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <TextBlock Text="Best Lap" Style="{StaticResource RowKey}"/>
                                <TextBlock x:Name="MonBestLap" Text="—" Style="{StaticResource RowVal}" Foreground="{StaticResource AccentBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,30,0">
                                <TextBlock Text="Avg (rolling)" Style="{StaticResource RowKey}"/>
                                <TextBlock x:Name="MonAvgLap" Text="—" Style="{StaticResource RowVal}"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Δ vs Best" Style="{StaticResource RowKey}"/>
                                <TextBlock x:Name="MonDeltaBest" Text="—" Style="{StaticResource RowVal}" Foreground="{StaticResource RedBrush}"/>
                            </Grid>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                </ctl:ResizableDataBox>
                <ctl:ResizableDataBox WidgetId="mon-strategy" Grid.Column="1">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Border Style="{StaticResource AccentBar}" Background="{StaticResource RedBrush}"/>
                        <StackPanel Margin="18,16">
                            <TextBlock Text="STRATEGY" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="MonStratAction" Text="—" FontSize="20" FontWeight="Bold" FontStyle="Italic" Margin="0,10,0,0"/>
                            <TextBlock x:Name="MonStratRationale" Text="" Foreground="{StaticResource Text3}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                    <TextBlock Text="Fuel margin " Foreground="{StaticResource Text3}" FontSize="14"/>
                                    <TextBlock x:Name="MonFuelMargin" Text="—" Style="{StaticResource Mono}" Foreground="{StaticResource GreenBrush}" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Cliff risk " Foreground="{StaticResource Text3}" FontSize="14"/>
                                    <TextBlock x:Name="MonCliffRisk" Text="—" Style="{StaticResource Mono}" Foreground="{StaticResource GreenBrush}" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                </ctl:ResizableDataBox>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
