<Window x:Class="LmuRaceEngineerCS.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        MinWidth="220" MinHeight="80"
        Width="320" Height="200"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Grid>
        <!-- Main content (4 px inset leaves room for edge grab areas) -->
        <Border Margin="4"
                Background="#EE111111"
                BorderBrush="#2e2e2e"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Drag / title bar -->
                <Border Grid.Row="0"
                        Background="#181818"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="DragBar_MouseDown">
                    <Grid>
                        <TextBlock x:Name="TbTitle"
                                   Foreground="#666666"
                                   FontFamily="Segoe UI"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="8,0"/>
                        <Button Content="✕"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Stretch"
                                Width="22"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#555555"
                                FontSize="10"
                                Cursor="Arrow"
                                Click="CloseBtn_Click"/>
                    </Grid>
                </Border>

                <!-- Widget content — Viewbox scales the text with the window size -->
                <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="Both"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         Margin="10,8,10,10">
                    <ContentControl x:Name="WidgetHost"/>
                </Viewbox>

                <!-- SE corner grip visual (decorative, no hit-test) -->
                <Path Grid.Row="1"
                      Data="M 0 10 L 10 10 L 10 0"
                      Stroke="#404040" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Width="12" Height="12" Margin="0,0,2,2"
                      IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ═══ Edge resize Thumbs (transparent, sit in 4 px window margin) ═══ -->

        <!-- N edge -->
        <Thumb VerticalAlignment="Top" HorizontalAlignment="Stretch"
               Height="4" Margin="8,0,8,0" Cursor="SizeNS" DragDelta="ResizeN_Delta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- S edge -->
        <Thumb VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
               Height="4" Margin="8,0,8,0" Cursor="SizeNS" DragDelta="ResizeS_Delta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- W edge -->
        <Thumb HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Width="4" Margin="0,8,0,8" Cursor="SizeWE" DragDelta="ResizeW_Delta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- E edge -->
        <Thumb HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Width="4" Margin="0,8,0,8" Cursor="SizeWE" DragDelta="ResizeE_Delta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- NW corner -->
        <Thumb VerticalAlignment="Top" HorizontalAlignment="Left"
               Width="8" Height="8" Cursor="SizeNWSE" DragDelta="ResizeNW_Delta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- NE corner -->
        <Thumb VerticalAlignment="Top" HorizontalAlignment="Right"
               Width="8" Height="8" Cursor="SizeNESW" DragDelta="ResizeNE_Delta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- SW corner -->
        <Thumb VerticalAlignment="Bottom" HorizontalAlignment="Left"
               Width="8" Height="8" Cursor="SizeNESW" DragDelta="ResizeSW_Delta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
            </Thumb.Template>
        </Thumb>

        <!-- SE corner -->
        <Thumb VerticalAlignment="Bottom" HorizontalAlignment="Right"
               Width="8" Height="8" Cursor="SizeNWSE" DragDelta="ResizeSE_Delta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb"><Rectangle Fill="Transparent"/></ControlTemplate>
            </Thumb.Template>
        </Thumb>

    </Grid>
</Window>
