<UserControl x:Class="LmuRaceEngineerCS.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgApp}">

    <UserControl.Resources>
        <!-- Dark editable input -->
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgTableHead}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text5}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,22" MaxWidth="1040" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>

            <!-- ── Voice / TTS ──────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel Margin="20,18">
                    <TextBlock Text="VOICE / TTS" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TTS Voice" Style="{StaticResource RowLabel}"/>
                        <ComboBox x:Name="VoiceCombo" Grid.Column="1" FontFamily="{StaticResource FontMono}" FontSize="13">
                            <ComboBoxItem Content="en-US-GuyNeural"/>
                            <ComboBoxItem Content="en-US-ChristopherNeural"/>
                            <ComboBoxItem Content="en-US-EricNeural"/>
                            <ComboBoxItem Content="en-GB-RyanNeural"/>
                            <ComboBoxItem Content="en-GB-ThomasNeural"/>
                            <ComboBoxItem Content="en-AU-WilliamNeural"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TTS Volume" Style="{StaticResource RowLabel}"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="1"
                                TickFrequency="0.1" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                                Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="VolLabel" Grid.Column="2" Text="1.0" Style="{StaticResource Mono}"
                                   FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Hint}"
                               Text="Note: After changing voice, restart the app to regenerate cached static phrases."/>
                </StackPanel>
            </Border>

            <!-- ── Overlays ─────────────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel Margin="20,18">
                    <TextBlock Text="OVERLAYS" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Hint}"
                               Text="Always-on-top windows to place over the game. Enabled overlays open automatically when a session starts and close when it ends. Drag the edges to resize — the text scales with the window, and position/size are remembered."/>
                    <StackPanel x:Name="OverlayList" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>

            <!-- ── Tire thresholds ──────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel Margin="20,18">
                    <TextBlock Text="TIRE THRESHOLDS" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl x:Name="TireSettings" Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,30,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource RowLabel}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource FieldInput}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Unit}" Style="{StaticResource UnitLabel}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ── Fuel calculation ─────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel Margin="20,18">
                    <TextBlock Text="FUEL CALCULATION" Style="{StaticResource SectionTitle}"/>
                    <UniformGrid Columns="2" Margin="0,16,0,0">
                        <Grid Margin="0,0,30,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fuel Safety Buffer" Style="{StaticResource RowLabel}"/>
                            <TextBox x:Name="FuelSafetyBox" Grid.Column="1" Style="{StaticResource FieldInput}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="laps" Style="{StaticResource UnitLabel}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Fuel Average History" Style="{StaticResource RowLabel}"/>
                            <TextBox x:Name="FuelHistoryBox" Grid.Column="1" Style="{StaticResource FieldInput}" TextAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="laps" Style="{StaticResource UnitLabel}"/>
                        </Grid>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- ── Speech recognition (accent bar) ──────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                    <Border Style="{StaticResource AccentBar}"/>
                    <StackPanel Margin="20,18">
                        <TextBlock Text="SPEECH RECOGNITION" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Margin="0,10,0,14" Style="{StaticResource Hint}"
                                   Text="Listens on your default microphone and speaks responses using the engineer voice. Requires a Windows speech language pack (English)."/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Enable STT" Style="{StaticResource RowLabel}"/>
                            <CheckBox x:Name="SttEnabledCheck" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Confidence Threshold" Style="{StaticResource RowLabel}"/>
                            <Slider x:Name="ConfidenceSlider" Grid.Column="1" Minimum="0.0" Maximum="1.0"
                                    TickFrequency="0.05" IsSnapToTickEnabled="False" VerticalAlignment="Center"
                                    Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock x:Name="ConfLabel" Grid.Column="2" Text="60%" Style="{StaticResource Mono}"
                                       FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Hint}"
                                   Text="Higher = stricter (fewer false triggers). Lower = more permissive. 50–70% works well in most environments."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Voice commands ───────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel Margin="20,18">
                    <TextBlock Text="VOICE COMMANDS" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Margin="0,10,0,14" Style="{StaticResource Hint}"
                               Text="Edit the phrases that trigger each intent. Separate phrases with commas. Intent names are fixed. Changes take effect after Save."/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="2.3*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="INTENT" Style="{StaticResource Caption}"/>
                        <TextBlock Grid.Column="1" Text="PHRASES (comma-separated)" Style="{StaticResource Caption}"/>
                    </Grid>
                    <Border BorderBrush="{StaticResource Border3}" BorderThickness="0,1,0,0" Margin="0,9,0,0"/>
                    <ItemsControl x:Name="VoiceCmdList" MaxHeight="320">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1">
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="2.3*"/></Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayIntent}" FontSize="14"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding Phrases, UpdateSourceTrigger=LostFocus}"
                                                 Style="{StaticResource FieldInput}" FontSize="12" TextWrapping="Wrap"
                                                 Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ── Driver profile ───────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel Margin="20,18">
                    <TextBlock Text="DRIVER PROFILE" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Margin="0,10,0,12" Style="{StaticResource Hint}"
                               Text="Clears all learned tire-degradation data for every track. Rebuilt as you drive. Does not delete lap CSVs."/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnResetProfile" Content="Reset Driver Profile" Click="ResetProfile_Click"
                                Padding="14,8" Background="{StaticResource RedBrush}" Foreground="White"
                                BorderThickness="0" FontSize="13" Cursor="Hand"/>
                        <TextBlock x:Name="ResetProfileStatus" Text="" Foreground="{StaticResource GreenBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Strategy engine ──────────────────────────────────────────── -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel Margin="20,18">
                    <TextBlock Text="STRATEGY ENGINE" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Compute Interval" Style="{StaticResource RowLabel}"/>
                        <TextBox x:Name="StratIntervalBox" Grid.Column="1" Style="{StaticResource FieldInput}" TextAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource UnitLabel}"/>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Voice-Only Mode" Style="{StaticResource RowLabel}"/>
                        <CheckBox x:Name="StratVoiceOnlyCheck" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                    </Grid>
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Hint}"
                               Text="When enabled, the strategy engine only computes when you ask a voice command. Reduces background CPU usage."/>
                </StackPanel>
            </Border>

            <!-- ── Save ─────────────────────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="Save Settings" Click="Save_Click" Padding="18,9"
                        Background="{StaticResource AccentBrush}" Foreground="White"
                        BorderThickness="0" FontSize="14" FontWeight="SemiBold" Cursor="Hand"/>
                <TextBlock x:Name="SaveStatus" Text="" Foreground="{StaticResource GreenBrush}"
                           FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>

            <Border Height="10" Background="Transparent"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
