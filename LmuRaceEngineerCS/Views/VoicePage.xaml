<UserControl x:Class="LmuRaceEngineerCS.Views.VoicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Voice Log" Foreground="{StaticResource FgBrush}"
                   FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>

        <!-- Voice command (microphone) panel -->
        <Border Grid.Row="1" Style="{StaticResource PrimaryCard}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="VOICE COMMANDS (MICROPHONE)" Style="{StaticResource LabelXs}" Margin="0,0,0,4"/>
                <Rectangle Height="1" Fill="{StaticResource BorderBrush2}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="ChkListen" Content="Listen for voice commands"
                              Click="ChkListen_Click" VerticalAlignment="Center"
                              Foreground="{StaticResource FgBrush}" FontFamily="Segoe UI" FontSize="11"
                              Cursor="Hand"/>
                    <Border Background="{StaticResource Card2Brush}" CornerRadius="3"
                            Padding="8,3" Margin="16,0,0,0">
                        <TextBlock x:Name="SttStatusText" Text="⏹ Off"
                                   Foreground="{StaticResource FgBrush}"
                                   FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SttHint"
                           Text="Configure command phrases in the Settings tab. Requires a Windows speech recognizer."
                           Foreground="{StaticResource Dim2Brush}"
                           FontFamily="Segoe UI" FontSize="9" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- TTS test panel -->
        <Border Grid.Row="2" Style="{StaticResource PrimaryCard}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="TTS TEST" Style="{StaticResource LabelXs}" Margin="0,0,0,4"/>
                <Rectangle Height="1" Fill="{StaticResource BorderBrush2}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="TtsTestBox" Width="320" Padding="6,4"
                             Background="{StaticResource Card2Brush}"
                             Foreground="{StaticResource FgBrush}"
                             BorderBrush="{StaticResource BorderBrush2}"
                             FontFamily="Segoe UI" FontSize="10"
                             Text="Gap to car ahead is 2.4 seconds."
                             Margin="0,0,8,0"/>
                    <Button Content="▶ Speak" Click="Speak_Click" Padding="10,4"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White" BorderThickness="0"
                            FontFamily="Segoe UI" FontSize="10" Cursor="Hand"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Shortcut phrases: " Style="{StaticResource LabelXs}" VerticalAlignment="Center"/>
                    <Button Content="Radio Check" Tag="radio_check" Click="Shortcut_Click" Padding="6,3" Margin="4,0"
                            Background="{StaticResource Card2Brush}" Foreground="{StaticResource FgBrush}"
                            BorderThickness="0" FontFamily="Segoe UI" FontSize="9" Cursor="Hand"/>
                    <Button Content="Lap Invalid" Tag="lap_invalid" Click="Shortcut_Click" Padding="6,3" Margin="4,0"
                            Background="{StaticResource Card2Brush}" Foreground="{StaticResource FgBrush}"
                            BorderThickness="0" FontFamily="Segoe UI" FontSize="9" Cursor="Hand"/>
                    <Button Content="Push Mode" Tag="push_mode" Click="Shortcut_Click" Padding="6,3" Margin="4,0"
                            Background="{StaticResource PushBrush}" Foreground="White"
                            BorderThickness="0" FontFamily="Segoe UI" FontSize="9" Cursor="Hand"/>
                    <Button Content="Save Mode" Tag="save_mode" Click="Shortcut_Click" Padding="6,3" Margin="4,0"
                            Background="{StaticResource SaveBrush}" Foreground="Black"
                            BorderThickness="0" FontFamily="Segoe UI" FontSize="9" Cursor="Hand"/>
                </StackPanel>
                <TextBlock x:Name="TtsStatus" Text="Edge TTS ready — pre-generating static phrases…"
                           Foreground="{StaticResource Dim2Brush}"
                           FontFamily="Segoe UI" FontSize="9" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Log output -->
        <Border Grid.Row="3" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="TTS DEBUG LOG" Style="{StaticResource LabelXs}" VerticalAlignment="Center"/>
                        <Button Content="Clear" Click="ClearLog_Click" Padding="6,2" Margin="12,0,0,0"
                                Background="{StaticResource BorderBrush2}" Foreground="{StaticResource DimBrush}"
                                BorderThickness="0" FontFamily="Segoe UI" FontSize="8" Cursor="Hand"/>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TbLog" FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource Dim2Brush}"
                               Margin="8,4" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
